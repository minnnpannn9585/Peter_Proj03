    "size": 2.0,
    "levelHeight": 1.5,
    "cells": [58, 40],
    "origin": [0, 0],
    "visualScale": 2.1,
    "viewPadCells": 1.25
  },
  "rules": {
    "baseSpeed": 5.0,
    "minGap": 1.15,
    "jamStallSeconds": 3.0,
    "fastMultiplier": 2.0,
    "minBeltCells": 2,
    "maxBeltCells": 8,
    "minRampCellsPerLevel": 2
  },
  "gate": { "holdSeconds": 8.0 },
  "loadout": [ { "device": "gate", "count": 2 } ],

  // Four passes of roughly 25 parcels, so about 100 for the level.
  // Wave 3 leaves inlet and colour open, so it rolls both.
  // Wave 5 sets "parallel", meaning it runs at the same time as wave 4 on another inlet.
  "spawn": {
    "seed": 202,
    "startDelay": 1.0,
    "repeat": 4,
    "waves": [
      { "inlet": "in_a", "color": "red",   "count": 6, "spacing": 0.0, "delayAfter": 4.0 },
      { "inlet": "in_b", "color": "green", "count": 5, "spacing": 0.0, "delayAfter": "random 3~5" },
      { "inlet": "random", "color": "random", "count": "random 4~6", "spacing": 0.0, "delayAfter": 3.5 },
      { "inlet": "in_c", "color": "blue",   "count": 5, "spacing": 0.0, "delayAfter": 0.0 },
      { "inlet": "in_a", "color": "yellow", "count": 4, "spacing": 0.0,
        "delayAfter": "random 4~6", "parallel": true }
    ]
  },

  "nodes": [
